# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Code coverage profiles and other test artifacts
*.out
coverage.*
*.coverprofile
profile.cov

# Dependency directories (remove the comment below to include it)
# vendor/

# go.work is committed (repo root) so cli/dewey-mcp resolve the shared
# httpclient module from a fresh clone — see issue #433. go.work.sum stays
# ignored: it's a lockfile derived from the workspace's own module graph,
# regenerated by tooling rather than hand-edited.
go.work.sum

# env file
.env

# Generated MySQL root password (deploy.sh, issue #200)
.mysql-root-password

# Generated file/machine management passwords (deploy.sh, issue #332)
.files-password
.machines-password

# App directories
backend/store
backend/logs
backend/cache
backend/backup

# Shell script run logs (deploy.sh/cleanup.sh/package.sh, all repo-root
# scripts writing to <repo root>/logs) — anchored so it doesn't also match
# every other directory named "logs" in the tree, e.g.
# frontend/doctooladmin/src/routes/logs/ (issue #389's fileview page).
/logs/
backend/testing_tooling/logs/

# Compiled binary
backend/Dewey
cli/dewey-cli
dewey-mcp/dewey-mcp

# Docs staged for go:embed by package.sh (issue #379) — copies of the real
# source docs, not source themselves
cli/embedded_docs/

# Release bundles produced by package.sh
build-images/

# Stray AI-tool files, not part of the project
AGENTS.md
GEMINI.md
kryptos-cli/

# Mac file
.DS_Store

# Editor/IDE
# .idea/
# .vscode/
