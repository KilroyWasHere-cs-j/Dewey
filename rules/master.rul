{
  "rules": [
    {
      "name_match": ".*\\.txt$",
      "meta" : [{
        "tag1" : "nil"
      }]
      "action": "move_to_directory",
      "target_directory": "/documents/text_files"
    },
    {
      "name_match": ".*\\.jpg$",
      "action": "move_to_directory",
      "target_directory": "/images"
    }
  ]
}

