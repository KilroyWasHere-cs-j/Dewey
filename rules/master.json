 {
  "version": "0.1",
  "level": "0",
  "rules": [
    {
      "name_match": ".*\\.txt$",
      "action": "move_to_directory",
      "target_directory": "/text_files",
      "meta": [
        {
          "tag1": "text" 
        }
      ]
    },
    {
      "name_match": ".*\\.(jpg|png|gif)$",
      "action": "move_to_directory",
      "target_directory": "/images",
      "meta": [
        {
          "tag1": "image"
        } 
      ]
    },
    {
      "name_match": ".*\\.(pdf)$",
      "action": "move_to_directory",
      "target_directory": "/pdf",
      "meta": [
        {
          "tag1": "document"
        }
      ]
    },
    {
      "name_match": ".*\\.(docx)$",
      "action": "move_to_directory",
      "target_directory": "/pdf",
      "meta": [
        {
          "tag1": "document"
        }
      ]
    }
  ]
}
